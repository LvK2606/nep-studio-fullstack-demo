{
  "name": "nep-studio-fullstack-demo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Full-stack booking demo: Node.js, local SQLite and persistent Neon PostgreSQL on Render.",
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "start": "node server.mjs",
    "dev": "node --watch server.mjs",
    "test": "node --test tests/*.test.mjs",
    "deploy:cloudflare": "wrangler deploy",
    "dev:cloudflare": "wrangler dev"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "pg": "^8.16.3",
    "@neondatabase/serverless": "^1.2.0"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
