{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nep-studio-always-on",
  "main": "./cloudflare/worker.mjs",
  "compatibility_date": "2026-10-31",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/admin"
    ]
  }
}
