# Chạy "npm run setup" để tự sinh .env chứa mật khẩu quản trị và khóa ký phiên.
# Không commit .env lên GitHub.
PORT=3000
# ADMIN_PASSWORD=<auto-generated>
# SESSION_SECRET=<auto-generated>
# DB_PATH=data/bookings.sqlite

# PostgreSQL Neon (chỉ bật sau khi đã có database)
# DATABASE_URL=postgresql://... (giữ bí mật, không commit)
# REQUIRE_PERSISTENT_DB=true
